# Copy this file to .env.local for local development. Real secrets are
# never committed — only this documented example.

# PostgreSQL connection string. The value below matches compose.yaml's
# local development database exactly (see `pnpm db:up`).
DATABASE_URL=postgresql://untitled:untitled@localhost:5432/untitled

# Better Auth. Generate a real secret locally, e.g.:
#   openssl rand -base64 32
# Never commit a real value here — this is a placeholder shape only.
BETTER_AUTH_SECRET=replace-with-a-generated-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:3000

# TMDB (The Movie Database) API Read Access Token — from your own TMDB
# account: https://www.themoviedb.org/settings/api ("API Read Access
# Token", a long JWT — not the shorter "API Key"). Server-only; see
# docs/media-provider.md.
TMDB_API_TOKEN=replace-with-your-tmdb-api-read-access-token

# More service-specific variables will be added in later phases, together
# with their own typed validation.
#
# Conventions:
# - Server-only secrets: no prefix, never imported into Client Components.
# - Browser-exposed values: must use the NEXT_PUBLIC_ prefix intentionally.
